let s={};
let selectedScenario=0;
let apiState={connected:false,key:'',nomis:[],mock:false,provider:'nomi',kindroidId:'',kindroidName:''};
const $=id=>document.getElementById(id);
const API_BASE='https://api.nomi.ai/v1';
const KINDROID_API_BASE='https://api.kindroid.ai/v1';
const WEB_RELAY_BASE=String(window.BAD_DECISIONS_RELAY||'').replace(/\/$/,'');

function requireWebRelay(){
  if(!WEB_RELAY_BASE){
    throw new Error('Pocket Goat relay is not configured yet. Set BAD_DECISIONS_RELAY in config.js.');
  }
  return WEB_RELAY_BASE;
}

async function relayCall(payload){
  const relay=requireWebRelay();
  const response=await fetch(`${relay}/api`,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(payload)
  });
  const text=await response.text();
  let data={};
  try{data=JSON.parse(text);}catch(_e){data={raw:text};}
  if(!response.ok) throw new Error(data?.error||data?.message||text||`HTTP ${response.status}`);
  return data;
}


function escapeHTML(value=''){
  return String(value).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));
}

function setApiStatus(message,kind=''){
  const el=$('apiStatus');
  el.textContent=message;
  el.className='apiStatus'+(kind?` ${kind}`:'');
}

function isTauriDesktop(){
  return !!(window.__TAURI__?.core?.invoke);
}

async function nomiFetch(path,options={}){
  // Desktop mode: the Rust side makes the HTTPS request. This avoids browser CORS/file:// blocks.
  if(isTauriDesktop()){
    const invoke=window.__TAURI__.core.invoke;
    if(path==='/nomis' && (!options.method || options.method==='GET')){
      return await invoke('list_nomis',{apiKey:apiState.key});
    }
    const chatMatch=path.match(/^\/nomis\/([^/]+)\/chat$/);
    if(chatMatch && options.method==='POST'){
      let payload={};
      try{ payload=JSON.parse(options.body||'{}'); }catch(_e){}
      return await invoke('send_nomi_message',{
        apiKey:apiState.key,
        nomiUuid:decodeURIComponent(chatMatch[1]),
        messageText:payload.messageText||''
      });
    }
    throw new Error(`Desktop bridge does not support API path: ${path}`);
  }

  // Web/PWA mode: use the tiny relay so iPhone/Safari never has to fight provider CORS.
  if(path==='/nomis' && (!options.method || options.method==='GET')){
    return await relayCall({provider:'nomi',action:'list',apiKey:apiState.key});
  }
  const chatMatch=path.match(/^\/nomis\/([^/]+)\/chat$/);
  if(chatMatch && options.method==='POST'){
    let payload={};
    try{payload=JSON.parse(options.body||'{}');}catch(_e){}
    return await relayCall({
      provider:'nomi',
      action:'send',
      apiKey:apiState.key,
      companionId:decodeURIComponent(chatMatch[1]),
      messageText:payload.messageText||''
    });
  }
  throw new Error(`Web relay does not support Nomi path: ${path}`);
}


function providerLabel(provider=apiState.provider){
  return provider==='kindroid'?'Kindroid':'Nomi';
}

function resetCompanionConnection(){
  apiState.connected=false;
  apiState.key='';
  apiState.nomis=[];
  apiState.mock=false;
  $('nomiSelectLabel').classList.add('hidden');
}

function updateProviderUI(){
  const provider=$('providerSelect').value;
  apiState.provider=provider;
  resetCompanionConnection();

  const isKindroid=provider==='kindroid';
  $('kindroidFields').classList.toggle('hidden',!isKindroid);
  $('apiKey').placeholder=isKindroid?'Paste your Kindroid kn_ API key here':'Paste your Nomi API key here';
  $('connectNomi').textContent=isKindroid?'CONNECT KINDROID':'CONNECT NOMI';

  if(isKindroid){
    setApiStatus('Not connected. Kindroid needs your API key 